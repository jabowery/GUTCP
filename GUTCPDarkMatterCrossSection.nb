     RowBox[{"Quantity", "[", 
      RowBox[{"0.1", ",", "\"\<Grams\>\""}], "]"}]}], ";", 
    RowBox[{"(*", 
     RowBox[{"0.1", " ", "g"}], "*)"}], 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{"--", 
        RowBox[{"-", "LOCAL"}]}], " ", 
       RowBox[{"DENSITIES", "--"}]}], "-"}], "*)"}], 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Dark", " ", 
       RowBox[{"matter", ":", 
        RowBox[{
        "start", " ", "from", " ", "the", " ", "commonly", " ", "quoted", " ",
          "0.4", " ", 
         RowBox[{"GeV", "/", 
          RowBox[{"cm", "^", "3"}]}], " ", "and", " ", "convert", " ", "to", 
         " ", 
         RowBox[{"kg", "/", 
          RowBox[{"m", "^", "3"}]}], " ", "via", " ", "E"}]}]}], "=", 
      RowBox[{"m", " ", 
       RowBox[{"c", "^", "2"}]}]}], "*)"}], 
    RowBox[{"rhoDM0", "=", 
     RowBox[{
      RowBox[{"Quantity", "[", 
       RowBox[{"0.4", ",", "\"\<Gigaelectronvolts\>\""}], "]"}], "/", 
      RowBox[{"Quantity", "[", 
       RowBox[{"1", ",", 
        RowBox[{"\"\<Centimeters\>\"", "^", "3"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rhoDM", "=", 
     RowBox[{"UnitConvert", "[", 
      RowBox[{
       RowBox[{"rhoDM0", "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"codata", "[", "\"\<SpeedOfLight\>\"", "]"}], "^", "2"}], 
         ")"}]}], ",", 
       RowBox[{"\"\<Kilograms\>\"", "/", 
        RowBox[{"\"\<Meters\>\"", "^", "3"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Baryonic", " ", 
       RowBox[{"(", "tunable", ")"}]}], ":", 
      RowBox[{
      "set", " ", "a", " ", "smoothed", " ", "local", " ", "baryonic", " ", 
       "density"}]}], ";", 
     RowBox[{
     "edit", " ", "if", " ", "you", " ", "prefer", " ", "a", " ", "different",
       " ", "value"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rhoBar", "=", 
     RowBox[{"Quantity", "[", 
      RowBox[{
       RowBox[{"5", "*", 
        RowBox[{"10", "^", 
         RowBox[{"-", "23"}]}]}], ",", 
       RowBox[{"\"\<Kilograms\>\"", "/", 
        RowBox[{"\"\<Meters\>\"", "^", "3"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"--", 
     RowBox[{"-", 
      RowBox[{"GEOMETRY", ":", 
       RowBox[{
        RowBox[{
         RowBox[{"radius", "/", "diameter"}], " ", "of", " ", "sphere", " ", 
         "with", " ", "mass", " ", "m", " ", "at", " ", "density", " ", 
         RowBox[{"rho", "--"}]}], "-"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{
     RowBox[{"sphereRadius", "[", "rho_", "]"}], ":=", 
     RowBox[{"UnitConvert", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"3", " ", "m"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"4", " ", "Pi", " ", "rho"}], ")"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "3"}], ")"}]}], ",", "\"\<Kilometers\>\""}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sphereDiameter", "[", "rho_", "]"}], ":=", 
     RowBox[{"2", "*", 
      RowBox[{"sphereRadius", "[", "rho", "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rDM", "=", 
     RowBox[{"sphereRadius", "[", "rhoDM", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dDM", "=", 
     RowBox[{"sphereDiameter", "[", "rhoDM", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rBar", "=", 
     RowBox[{"sphereRadius", "[", "rhoBar", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dBar", "=", 
     RowBox[{"sphereDiameter", "[", "rhoBar", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "PRINT"}]}], " ", 
      RowBox[{"RESULTS", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Dark matter density (from 0.4 GeV/cm^3):  \[Rho]_DM = \>\"", ",", 
      RowBox[{"N", "@", 
       RowBox[{"UnitConvert", "[", 
        RowBox[{"rhoDM", ",", 
         RowBox[{"\"\<Kilograms\>\"", "/", 
          RowBox[{"\"\<Meters\>\"", "^", "3"}]}]}], "]"}]}]}], "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Baryonic density (user-set):              \[Rho]_b  = \>\"", ",", 
      RowBox[{"N", "@", 
       RowBox[{"UnitConvert", "[", 
        RowBox[{"rhoBar", ",", 
         RowBox[{"\"\<Kilograms\>\"", "/", 
          RowBox[{"\"\<Meters\>\"", "^", "3"}]}]}], "]"}]}], ",", 
      "\"\<\\n\>\""}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Sphere for m = \>\"", ",", "m", ",", "\"\<:\>\""}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Dark matter   \[RightArrow]  Radius = \>\"", ",", 
      RowBox[{"N", "[", 
       RowBox[{"rDM", ",", "6"}], "]"}], ",", "\"\<   Diameter = \>\"", ",", 
      RowBox[{"N", "[", 
       RowBox[{"dDM", ",", "6"}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Baryonic      \[RightArrow]  Radius = \>\"", ",", 
      RowBox[{"N", "[", 
       RowBox[{"rBar", ",", "6"}], "]"}], ",", "\"\<   Diameter = \>\"", ",", 
      
      RowBox[{"N", "[", 
       RowBox[{"dBar", ",", "6"}], "]"}], ",", "\"\<\\n\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Comparison"}]}], " ", "table", " ", 
      RowBox[{
       RowBox[{"(", "km", ")"}], "--"}]}], "-"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\"\<Component\>\"", ",", "\"\<Density (kg/m^3)\>\"", ",", 
         "\"\<Radius (km)\>\"", ",", "\"\<Diameter (km)\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Dark matter\>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"QuantityMagnitude", "@", 
            RowBox[{"UnitConvert", "[", 
             RowBox[{"rhoDM", ",", 
              RowBox[{"\"\<Kilograms\>\"", "/", 
               RowBox[{"\"\<Meters\>\"", "^", "3"}]}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "3"}], "}"}]}], "]"}], ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"QuantityMagnitude", "[", "rDM", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"6", ",", "2"}], "}"}]}], "]"}], ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"QuantityMagnitude", "[", "dDM", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"6", ",", "2"}], "}"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Baryonic\>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"QuantityMagnitude", "@", 
            RowBox[{"UnitConvert", "[", 
             RowBox[{"rhoBar", ",", 
              RowBox[{"\"\<Kilograms\>\"", "/", 
               RowBox[{"\"\<Meters\>\"", "^", "3"}]}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "3"}], "}"}]}], "]"}], ",", 
