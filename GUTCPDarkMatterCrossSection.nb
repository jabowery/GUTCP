            RowBox[{"6", ",", "2"}], "}"}]}], "]"}], ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"QuantityMagnitude", "[", "dBar", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"6", ",", "2"}], "}"}]}], "]"}]}], "}"}]}], "}"}], ",", 
     RowBox[{"Frame", "->", "All"}], ",", 
